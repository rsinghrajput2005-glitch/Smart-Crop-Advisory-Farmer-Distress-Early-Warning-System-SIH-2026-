# ─────────────────────────────────────────────────────────────
# Smart Crop Advisory & Farmer Distress Early-Warning System
# .env.example — Copy to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/sih2026

# ── Auth ─────────────────────────────────────────────────────
# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── External API Keys ─────────────────────────────────────────
# OpenWeatherMap API key — required for weather service
# Register free at: https://openweathermap.org (free tier supports current + 5-day forecast)
OPENWEATHER_API_KEY=your-openweathermap-api-key-here

# LLM API Key — required for the voice chatbot
# E.g. OpenAI (https://platform.openai.com) or Groq for fast inference
LLM_API_KEY=your-llm-api-key-here

# data.gov.in API key — required for AGMARKNET mandi prices (live integration)
# Register free at: https://data.gov.in
# NOTE: mandi_service.py currently uses MOCK data; key needed only after real integration
DATAGOV_API_KEY=your-datagov-api-key-here

# ── Email (Resend) ────────────────────────────────────────────
# Used to send OTP emails for farmer/officer registration
# Register free at: https://resend.com
RESEND_API_KEY=re_your-resend-api-key-here

# ── App Settings ──────────────────────────────────────────────
# "development" | "staging" | "production"
APP_ENV=development
DEBUG=true

# ── No key needed ─────────────────────────────────────────────
# Open-Meteo (weather)          → no API key required
# SoilGrids ISRIC (soil)        → no API key required
# MS Planetary Computer (NDVI)  → no API key required
